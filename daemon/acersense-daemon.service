[Unit]
Description=AcerSense Modern Background Hardware Daemon
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/acersense
Environment=PYTHONPATH=/opt/acersense
ExecStart=/usr/bin/python3 /opt/acersense/daemon/main.py
Restart=always
RestartSec=3
KillMode=process

[Install]
WantedBy=multi-user.target
